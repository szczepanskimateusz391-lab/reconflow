{
  "name": "reconflow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-isolated-e2e.ps1",
    "test:e2e:standalone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-standalone-e2e.ps1",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  },
  "packageManager": "pnpm@11.19.0"
}
